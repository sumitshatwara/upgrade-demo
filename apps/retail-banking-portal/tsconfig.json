{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@bofa/shared-ui": ["../../libs/shared-ui/src/lib/index.ts"],
      "@bofa/shared-data-access": ["../../libs/shared-data-access/src/lib/api/banking-api.service.ts"],
      "@bofa/shared-data-access/*": ["../../libs/shared-data-access/src/*"]
    },
    "outDir": "./dist/out-tsc",
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "noImplicitOverride": false,
    "noPropertyAccessFromIndexSignature": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "sourceMap": true,
    "declaration": false,
    "downlevelIteration": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "importHelpers": true,
    "target": "ES2017",
    "module": "ES2020",
    "lib": [
      "ES2020",
      "dom"
    ]
  },
  "include": [
    "src/**/*.ts",
    "../../libs/shared-ui/src/**/*.ts",
    "../../libs/shared-data-access/src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "../../libs/shared-ui/src/**/*.spec.ts",
    "../../libs/shared-data-access/src/**/*.spec.ts"
  ],
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": false,
    "strictInputAccessModifiers": false,
    "strictTemplates": false
  }
}
