{
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./out-tsc/spec",
    "module": "CommonJS",
    "target": "ES2017",
    "lib": ["ES2020", "dom"],
    "types": ["jest"],
    "esModuleInterop": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "moduleResolution": "node",
    "skipLibCheck": true,
    "strict": false
  },
  "include": [
    "src/**/*.spec.ts",
    "src/**/*.d.ts"
  ]
}
